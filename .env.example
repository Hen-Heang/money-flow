# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose this to the client — bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI providers (used by the AI Money Coach, transaction parsing and chat)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_FAST_MODEL=gpt-5-nano
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# Exchange rates
EXCHANGE_RATE_API_KEY=

# Telegram bot (expense logging via chat + Telegram delivery for
# weekly/monthly reports and alerts)
TELEGRAM_BOT_TOKEN=
# Shared secret Telegram sends back in the x-telegram-bot-api-secret-token
# header; set the same value when registering the webhook via
# /api/telegram/setup.
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Email delivery for the monthly report (Resend + React Email).
# Server-only — never referenced from client code.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Money Flow <reports@yourdomain.com>"

# Base URL used to build links back into the app (e.g. the monthly report's
# "view full monthly review" link). Falls back to https://$VERCEL_URL, then
# http://localhost:3000, if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret required on every /api/cron/* route's Authorization header
# (Bearer <CRON_SECRET>). Set the same value in Vercel's cron configuration.
CRON_SECRET=
